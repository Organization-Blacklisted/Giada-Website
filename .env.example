# Payload admin/auth signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Neon Postgres connection string (shared agency Neon org, see
# ARCHITECTURE.md's "CMS" section). Populated automatically by
# `neon link`/`neon deploy` — do not hand-edit, re-run those instead.
#
# Local development MUST point at the `development` branch, never
# `production` directly — this project's dev-mode schema auto-push
# previously ran straight against the live database (shared by Vercel),
# which caused two real production incidents on 2026-10-21/22 (see
# ARCHITECTURE.md's "CMS" / migrations section). `neon branches switch
# development` (or `neon link` against that branch) before pulling.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# Which Neon branch this .env was pulled from (set by `neon link`).
# Local dev: development. Only Vercel's own env vars should ever say
# production.
NEON_BRANCH=development

# Neon Object Storage (S3-compatible) credentials for the `giada-media`
# bucket, declared in neon.ts and provisioned via `neon deploy`. Also
# auto-populated by `neon link`/`neon deploy` — do not hand-edit.
AWS_ACCESS_KEY_ID=nak_xxx
AWS_SECRET_ACCESS_KEY=nsk_xxx
AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<region>.aws.neon.tech
AWS_REGION=us-east-1

# Shared secret sent as the x-revalidate-secret header when calling
# POST /api/revalidate to bust the ISR cache for a given tag — called
# from Payload's own afterChange hooks.
REVALIDATE_SECRET=change-me

# Client's Google Tag Manager container ID (not a secret — GTM container
# IDs are always visible in the page source, hence NEXT_PUBLIC_). Read by
# app/(frontend)/layout.tsx's <GoogleTagManager> — unset/blank just
# no-ops instead of firing a broken container.
NEXT_PUBLIC_GTM_ID=GTM-WCGH9SJW

# Brevo SMTP (Settings → SMTP & API → SMTP in Brevo's dashboard). Used
# by payload.config.ts's nodemailerAdapter for the Contact form's
# enquiry notification/confirmation emails. Host/port/login aren't
# secret — only the generated SMTP key is.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=change-me
BREVO_SMTP_KEY=change-me

# Cloudflare Turnstile (added 2026-10-23) — gates the Contact form's
# submitEnquiry Server Action (lib/actions/enquiry.ts), stops a missing/
# invalid token before anything is saved or emailed. Site Key is public
# (rendered client-side in EnquiryForm), Secret Key is server-only, used
# by lib/turnstile.ts's verifyTurnstile().
NEXT_PUBLIC_TURNSTILE_SITE_KEY=change-me
TURNSTILE_SECRET_KEY=change-me

# Brevo Contacts API (Settings → SMTP & API → "API keys & MCP" tab) —
# separate from the SMTP credentials above; this one manages the
# newsletter mailing list (lib/brevo.ts), not sending email. Scoped to
# Contacts: All only, nothing else needed.
BREVO_API_KEY=change-me
# The real subscriber list's ID (Brevo: Contacts → Lists → click the
# list → ID shown on its page/URL).
BREVO_NEWSLETTER_LIST_ID=change-me
