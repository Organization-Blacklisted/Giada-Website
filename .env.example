# Laravel API base URL — required, app throws at startup if missing.
# Server-side only (no NEXT_PUBLIC_ prefix): all data fetching happens in
# Server Components/Server Actions, so the browser never needs this.
# Include trailing path but no trailing slash, e.g. https://api.example.com/api
API_URL=https://your-laravel-api.com/api

# Shared secret Laravel sends as the x-revalidate-secret header when calling
# POST /api/revalidate to bust the ISR cache for a given tag.
REVALIDATE_SECRET=change-me
